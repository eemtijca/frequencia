# Variáveis de ambiente do FrequencIA. Copie para .env e ajuste conforme a
# realidade local. Nenhum segredo de produção existe neste projeto: tudo roda
# local, sem credenciais externas.

# Pasta raiz do workspace: onde var/ guarda dados, artefatos, logs e estado.
# Padrão: a própria pasta do repositório.
FREQUENCIA_WORKSPACE=

# URI de rastreamento do MLflow. Padrão: SQLite local em var/mlflow/mlflow.db.
# Com o Docker Compose, use http://mlflow:5000 (o serviço sobe o servidor).
FREQUENCIA_MLFLOW_URI=

# Semente global para geração sintética e experimentos reproduzíveis.
FREQUENCIA_SEMENTE=20261018

# Perfil de ambiente: padrao, fumaca (menor volume, mais rápido) ou ciclo.
FREQUENCIA_PERFIL=padrao

# Fuso horário usado para rótulos de datas e dia corrente.
FREQUENCIA_FUSO=America/Fortaleza
